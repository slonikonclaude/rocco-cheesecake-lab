.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Данные для отбора фото (DESIGN.md §1): снимки Google и приложений доставки, среди них
# фото гостей с лицами и тикеты с NIF владельца — в публичный репозиторий не идут;
# восстанавливаются по ссылкам из _data/maps/all-photos.json и _data/web/*.json.
/_data/photos/
/_data/crops/
/_data/photo-sheets/*.jpg
/_data/*.jpg
/_data/*.png
# Сырые страницы доставки и поиска (сотни КБ разметки; разобранное лежит рядом в JSON).
/_data/web/*.html
/_data/web/*-flight.txt
/_data/maps/searchviewer.html
